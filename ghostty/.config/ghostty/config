theme = Catppuccin Mocha

font-family = MesloLGS NF
font-size = 16

background-blur-radius = 20

mouse-hide-while-typing = true
window-decoration = false
macos-titlebar-style = hidden

macos-option-as-alt = true
keybind = shift+enter=text:\n
shell-integration-features = ssh-terminfo,ssh-env

# Claude Code rings the bell when an agent finishes or needs input. The default
# feature set only bounces the dock, which is invisible when Ghostty is fully
# backgrounded -- "system" adds a real macOS notification.
bell-features = system,attention,title
