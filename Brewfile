brew "ripgrep"      # fast grep (`rg`)
brew "stow"
brew "tmux"
brew "tree"
brew "vivid"        # Catppuccin Mocha LS_COLORS generator
brew "yazi"         # terminal file manager (`y`)
brew "zoxide"       # smart directory jumper (`z`)

# --- AI & Data / Search / Text Processing (GNU parity with Linux) -----------
